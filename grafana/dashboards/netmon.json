            "uid": "netmon"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "-- Each bucket shows the worst state in it, so short drops aren't averaged away\nWITH buckets AS (\n  SELECT time_bucket(to_milliseconds($__interval_ms), ts) AS time,\n         coalesce(max(link) FILTER (WHERE link != 'plugged'), 'plugged') AS \"WAN cable\",\n         coalesce(max(dial) FILTER (WHERE dial != 'connected'), 'connected') AS \"DHCP\",\n         coalesce(max(inet) FILTER (WHERE inet != 'online'), 'online') AS \"internet\",\n         string_agg(DISTINCT ip, ', ' ORDER BY ip) AS \"WAN IP\"\n  FROM deco_wan\n  WHERE $__timeFilter(ts)\n  GROUP BY ALL\n)\nSELECT time, \"WAN cable\", \"DHCP\", \"internet\", \"WAN IP\"\nFROM range(time_bucket(to_milliseconds($__interval_ms), $__timeFrom::TIMESTAMPTZ), $__timeTo::TIMESTAMPTZ, to_milliseconds($__interval_ms)) r(time)\nLEFT JOIN buckets USING (time)\nORDER BY time\n",
          "refId": "A"
        }
      ],
      "title": "The main Deco's internet connection, as it sees it",
      "type": "state-timeline"
