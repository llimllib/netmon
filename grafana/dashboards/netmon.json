          "rawQuery": true,
          "rawSql": "SELECT client, arg_max(conn, ts) AS connection, arg_max(ip, ts) AS ip,\n       sum(down_bytes) AS download, sum(up_bytes) AS upload\nFROM traffic\nWHERE $__timeFilter(ts)\nGROUP BY client\nORDER BY download DESC\n",
          "refId": "A"
        }
      ],
      "title": "Data used (estimated from 15s samples)",
