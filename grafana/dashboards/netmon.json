  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "annotations": {
    "list": [
      {
        "name": "Outages",
        "datasource": {
          "type": "motherduck-duckdb-datasource",
          "uid": "netmon"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "netmon"
          },
          "rawSql": "SELECT start_ts AS time, end_ts AS timeend, host || ': ' || diagnosis AS text\nFROM report\nWHERE $__timeFilter(start_ts)",
          "format": 1,
          "editorMode": "code",
          "rawQuery": true
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "datasource": {
          "type": "motherduck-duckdb-datasource",
          "uid": "netmon"
        },
        "query": "SELECT DISTINCT host FROM host_targets",
        "definition": "SELECT DISTINCT host FROM host_targets",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "sort": 1
      },
      {
        "name": "wifi_host",
        "type": "query",
        "datasource": {
          "type": "motherduck-duckdb-datasource",
          "uid": "netmon"
        },
        "query": "SELECT DISTINCT host FROM host_columns WHERE col = 'rssi'",
        "definition": "SELECT DISTINCT host FROM host_columns WHERE col = 'rssi'",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Outages (3s or longer; click a start time to zoom in)",
      "datasource": {
        "type": "motherduck-duckdb-datasource",
        "uid": "netmon"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "netmon"
          },
          "rawSql": "-- zoom_from and zoom_to are hidden, and used by the link to zoom in\nSELECT start_ts AS start, host, diagnosis, epoch(duration) AS duration,\n       bad_secs AS \"bad seconds\",\n       array_to_string(first_failed, ', ') AS \"first failed\",\n       array_to_string(all_failed, ', ') AS \"all failed\",\n       other_hosts AS \"other monitors saw\",\n       epoch_ms(start_ts) - 60000 AS zoom_from,\n       epoch_ms(end_ts) + 60000 AS zoom_to\nFROM report\nWHERE $__timeFilter(start_ts)\nORDER BY start_ts DESC",
          "format": 1,
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "start"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Zoom in",
                    "url": "/d/netmon/netmon?from=${__data.fields.zoom_from}&to=${__data.fields.zoom_to}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "zoom_.*"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 1
    },
    {
      "type": "row",
      "title": "$host",
      "repeat": "host",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "$host: latency (log scale)",
      "datasource": {
        "type": "motherduck-duckdb-datasource",
        "uid": "netmon"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "interval": "1s",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "netmon"
          },
          "rawSql": "WITH buckets AS (\n  SELECT time_bucket(to_milliseconds($__interval_ms), ts) AS time, target, avg(ms) AS value\n  FROM results\n  WHERE host = '$host' AND $__timeFilter(ts)\n  GROUP BY ALL\n)\nSELECT time, target, value\nFROM range(time_bucket(to_milliseconds($__interval_ms), $__timeFrom::TIMESTAMPTZ), $__timeTo::TIMESTAMPTZ, to_milliseconds($__interval_ms)) r(time)\nCROSS JOIN (SELECT target FROM host_targets WHERE host = '$host')\nLEFT JOIN buckets USING (time, target)\nORDER BY time",
          "format": 0,
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false,
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          },
          "displayName": "${__field.labels.target}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "$host: packet loss",
      "datasource": {
        "type": "motherduck-duckdb-datasource",
        "uid": "netmon"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "interval": "1s",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "netmon"
          },
          "rawSql": "WITH buckets AS (\n  SELECT time_bucket(to_milliseconds($__interval_ms), ts) AS time, target, 100 * avg((ms IS NULL)::int) AS value\n  FROM results\n  WHERE host = '$host' AND $__timeFilter(ts)\n  GROUP BY ALL\n)\nSELECT time, target, value\nFROM range(time_bucket(to_milliseconds($__interval_ms), $__timeFrom::TIMESTAMPTZ), $__timeTo::TIMESTAMPTZ, to_milliseconds($__interval_ms)) r(time)\nCROSS JOIN (SELECT target FROM host_targets WHERE host = '$host')\nLEFT JOIN buckets USING (time, target)\nORDER BY time",
          "format": 0,
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20,
            "spanNulls": false,
            "lineInterpolation": "stepAfter"
          },
          "min": 0,
          "max": 100,
          "displayName": "${__field.labels.target}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 4
    },
    {
      "type": "row",
      "title": "$wifi_host: Wi-Fi",
      "repeat": "wifi_host",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": [],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "$wifi_host: Wi-Fi",
      "datasource": {
        "type": "motherduck-duckdb-datasource",
        "uid": "netmon"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 9
      },
      "interval": "1s",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "netmon"
          },
          "rawSql": "WITH buckets AS (\n  SELECT time_bucket(to_milliseconds($__interval_ms), ts) AS time, avg(rssi) AS signal, avg(tx_rate) AS \"tx rate\"\n  FROM pings\n  WHERE host = '$wifi_host' AND $__timeFilter(ts)\n  GROUP BY ALL\n)\nSELECT time, signal, \"tx rate\"\nFROM range(time_bucket(to_milliseconds($__interval_ms), $__timeFrom::TIMESTAMPTZ), $__timeTo::TIMESTAMPTZ, to_milliseconds($__interval_ms)) r(time)\nLEFT JOIN buckets USING (time)\nORDER BY time",
          "format": 0,
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "tx rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Mbits"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 6
    }
  ]
}
