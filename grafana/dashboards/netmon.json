          "editorMode": "code",
          "format": 0,
          "rawQuery": true,
          "rawSql": "WITH buckets AS (\n  SELECT time_bucket(to_milliseconds($__interval_ms), ts) AS time, avg(rssi) AS signal, avg(tx_rate) AS \"tx rate\"\n  FROM pings\n  WHERE host = $wifi_host AND $__timeFilter(ts)\n  GROUP BY ALL\n)\nSELECT time, signal, \"tx rate\"\nFROM range(time_bucket(to_milliseconds($__interval_ms), $__timeFrom::TIMESTAMPTZ), $__timeTo::TIMESTAMPTZ, to_milliseconds($__interval_ms)) r(time)\nLEFT JOIN buckets USING (time)\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "${wifi_host:text}: Wi-Fi",
      "type": "timeseries"
