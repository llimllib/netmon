          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "-- One column per Wi-Fi client, holding the Deco it was last on in each bucket\nPIVOT (\n  SELECT time_bucket(to_milliseconds($__interval_ms), ts) AS time, client, arg_max(deco, ts) AS deco\n  FROM traffic\n  WHERE $__timeFilter(ts) AND conn != 'wired' AND coalesce(deco, '') != ''\n  GROUP BY ALL\n) ON client USING any_value(deco) GROUP BY time ORDER BY time\n",
          "refId": "A"
        }
