        }
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "netmon"
          },
          "editorMode": "code",
          "format": 0,
          "rawQuery": true,
          "rawSql": "-- A client missing from a sample was offline, so it counts as 0, but a\n-- bucket with no samples at all is a gap\nWITH t AS (\n  SELECT time_bucket(to_milliseconds($__interval_ms), ts) AS time, ts, client, down_kbps\n  FROM traffic\n  WHERE $__timeFilter(ts)\n), top AS (\n  SELECT client FROM t GROUP BY client HAVING sum(down_kbps) > 0 ORDER BY sum(down_kbps) DESC LIMIT 8\n), samples AS (\n  SELECT time, count(DISTINCT ts) AS n FROM t GROUP BY time\n), buckets AS (\n  SELECT time, CASE WHEN client IN (SELECT client FROM top) THEN client ELSE 'other' END AS client,\n         sum(down_kbps) * 1000 AS total\n  FROM t\n  GROUP BY ALL\n)\nSELECT time, client, CASE WHEN n IS NOT NULL THEN coalesce(total, 0) / n END AS value\nFROM range(time_bucket(to_milliseconds($__interval_ms), $__timeFrom::TIMESTAMPTZ), $__timeTo::TIMESTAMPTZ, to_milliseconds($__interval_ms)) r(time)\nCROSS JOIN (SELECT client FROM top UNION ALL SELECT 'other')\nLEFT JOIN samples USING (time)\nLEFT JOIN buckets USING (time, client)\nORDER BY time\n",
          "refId": "A"
        }
      ],
      "title": "Download by client (busiest 8)",
      "type": "timeseries"
    },
