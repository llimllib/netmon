      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "netmon"
          },
          "editorMode": "code",
          "format": 0,
          "rawQuery": true,
          "rawSql": "-- The Deco reports kbit/s\nWITH samples AS (\n  SELECT ts, sum(down_kbps) * 1000 AS download, sum(up_kbps) * 1000 AS upload\n  FROM traffic\n  WHERE $__timeFilter(ts)\n  GROUP BY ts\n), buckets AS (\n  SELECT time_bucket(to_milliseconds($__interval_ms), ts) AS time, avg(download) AS download, avg(upload) AS upload\n  FROM samples\n  GROUP BY ALL\n)\nSELECT time, download, upload\nFROM range(time_bucket(to_milliseconds($__interval_ms), $__timeFrom::TIMESTAMPTZ), $__timeTo::TIMESTAMPTZ, to_milliseconds($__interval_ms)) r(time)\nLEFT JOIN buckets USING (time)\nORDER BY time\n",
          "refId": "A"
        }
      ],
      "title": "Internet throughput (upload below the axis)",
      "type": "timeseries"
    },
    {
      "datasource": {
