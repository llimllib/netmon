        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "netmon"
          },
          "editorMode": "code",
          "format": 1,
          "rawQuery": true,
          "rawSql": "-- zoom_from and zoom_to are hidden, and used by the link to zoom in\nSELECT start_ts AS start, coalesce(name, host) AS host, diagnosis, epoch(duration) AS duration,\n       bad_secs AS \"bad seconds\",\n       array_to_string(first_failed, ', ') AS \"first failed\",\n       array_to_string(all_failed, ', ') AS \"all failed\",\n       other_hosts AS \"other monitors saw\",\n       epoch_ms(start_ts) - 60000 AS zoom_from,\n       epoch_ms(end_ts) + 60000 AS zoom_to\nFROM report LEFT JOIN host_names USING (host)\nWHERE $__timeFilter(start_ts)\nORDER BY start_ts DESC",
          "refId": "A"
        }
      ],
      "title": "Outages (3s or longer; click a start time to zoom in)",
      "type": "table"
    },
