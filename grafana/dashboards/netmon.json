        "uid": "netmon"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 1,
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
