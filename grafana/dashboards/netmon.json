          "editorMode": "code",
          "format": 0,
          "rawQuery": true,
          "rawSql": "-- The weakest signal in each bucket, so dips show when zoomed out\nWITH signals AS (\n  UNPIVOT (SELECT ts, name, signal_5g AS \"5 GHz\", signal_6g AS \"6 GHz\"\n           FROM deco_nodes\n           WHERE role != 'master' AND $__timeFilter(ts))\n  ON \"5 GHz\", \"6 GHz\" INTO NAME band VALUE signal\n), buckets AS (\n  SELECT time_bucket(to_milliseconds($__interval_ms), ts) AS time, name || ' ' || band AS series, min(signal) AS value\n  FROM signals\n  GROUP BY ALL\n)\nSELECT time, series, value\nFROM range(time_bucket(to_milliseconds($__interval_ms), $__timeFrom::TIMESTAMPTZ), $__timeTo::TIMESTAMPTZ, to_milliseconds($__interval_ms)) r(time)\nCROSS JOIN (SELECT DISTINCT series FROM buckets)\nLEFT JOIN buckets USING (time, series)\nORDER BY time\n",
          "refId": "A"
        }
      ],
      "title": "Satellites' backhaul signal (Deco app bars)",
      "type": "timeseries"
