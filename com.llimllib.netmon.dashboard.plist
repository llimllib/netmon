<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.llimllib.netmon.dashboard</string>
  <!-- launchd's PATH doesn't include uv, so run it through mise -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/mise</string>
    <string>exec</string>
    <string>--</string>
    <string>uv</string>
    <string>run</string>
    <string>--script</string>
    <string>/Users/llimllib/netmon/dashboard.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/llimllib/netmon</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/llimllib/netmon/dashboard.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/llimllib/netmon/dashboard.log</string>
</dict>
</plist>
